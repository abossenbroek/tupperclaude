#!/usr/bin/env zsh
# _claude_docker_help <command-name>
#
# Print the usage block for one of the eight run/build wrappers. Their
# `-h|--help` routes through here so the shape is identical across all eight:
#
#   <name> — <one-line summary>
#
#   Usage: ...
#
#   <what it does, and what it needs>
#
#   See also: ...
#
# Keeping the text here rather than in each wrapper is what makes that
# consistency mechanical instead of aspirational — the wrappers stay one line
# of dispatch plus one line of help.
#
# Deliberately NOT the five utility commands (doctor, status, shell, configure,
# clean). Each of those takes flags of its own and documents them in its own
# `-h|--help`, next to the parser that accepts them; entries here for them were
# never called, and drifted — the clean entry published a flag list the parser
# disagreed with. One published usage string per command, living beside its
# parser, is the only arrangement that cannot rot.
#
# The `run` shape deliberately reserves -h/--help and -v/--version for the
# wrapper: `claude-docker-arm --help` describes the wrapper, and
# `claude-docker-arm -- --help` passes it through to claude. Without the
# reservation there is no way to ask the wrapper itself for help — and --version
# in particular would otherwise start a container, write MACHINE.md and mint a
# tailnet node to answer a question about a version string.

emulate -L zsh
setopt local_options

local cmd=${1-}
local shape='' summary='' detail='' requires=''

case $cmd in
    claude-docker-arm)
        shape=run
        summary='run Claude Code in the linux/arm64 sandbox'
        detail='Runs the base image, native on Apple Silicon. Networking follows the `network` option (default: tailscale).'
        requires='claude-docker-build-arm'
        ;;
    claude-docker-amd64)
        shape=run
        summary='run Claude Code in the linux/amd64 sandbox'
        detail='Runs the base image — native on Intel Macs, QEMU-emulated on Apple Silicon. Networking follows the `network` option (default: tailscale).'
        requires='claude-docker-build-amd64'
        ;;
    claude-docker-arm-playwright)
        shape=run
        summary='run Claude Code in the browser-capable linux/arm64 sandbox'
        detail='Runs the Playwright image, native on Apple Silicon. Separate state root and Tailscale node from the base sandbox. Networking follows the `network` option (default: tailscale).'
        requires='claude-docker-build-arm-playwright'
        ;;
    claude-docker-amd64-playwright)
        shape=run
        summary='run Claude Code in the browser-capable linux/amd64 sandbox'
        detail='Runs the Playwright image — native on Intel Macs, QEMU-emulated on Apple Silicon. Separate state root and Tailscale node from the base sandbox. Networking follows the `network` option (default: tailscale).'
        requires='claude-docker-build-amd64-playwright'
        ;;
    claude-docker-build-arm)
        shape=build
        summary='build the linux/arm64 base image'
        detail='Builds claude-code-full-arm64 natively on Apple Silicon. Bakes in your non-secret Claude Code config; credentials are mounted at run time, never baked.'
        ;;
    claude-docker-build-amd64)
        shape=build
        summary='build the linux/amd64 base image'
        detail='Builds claude-code-full-amd64 — native on Intel Macs, a slow QEMU cross-build on Apple Silicon. Bakes in your non-secret Claude Code config; credentials are mounted at run time, never baked.'
        ;;
    claude-docker-build-arm-playwright)
        shape=build
        summary='build the browser-capable linux/arm64 image'
        detail='Builds claude-code-full-playwright-arm64 FROM the arm64 base image.'
        requires='claude-docker-build-arm'
        ;;
    claude-docker-build-amd64-playwright)
        shape=build
        summary='build the browser-capable linux/amd64 image'
        detail='Builds claude-code-full-playwright-amd64 FROM the amd64 base image.'
        requires='claude-docker-build-amd64'
        ;;
    *)
        _claude_docker_err "no help for '$cmd'" "tupperclaude --help"
        return 1
        ;;
esac

print -r -- "$cmd — $summary"
print ""
case $shape in
    run)
        print -r -- "Usage: $cmd [claude args...]"
        print -r -- "       $cmd -- --help      # pass --help through to claude"
        print ""
        print -r -- "  -h, --help     show this message"
        print -r -- "  -v, --version  print the tupperclaude version"
        print -r -- "Every other argument goes to claude; \`--\` sends -h/-v there too."
        ;;
    build)
        # The flag and the cost belong together: -y is how you skip the
        # confirmation, so --help has to say what that confirmation was for.
        print -r -- "Usage: $cmd [-y|--yes]"
        print ""
        print -r -- "  -y, --yes  build without the confirmation prompt"
        print -r -- "Takes ~15 minutes and ~9 GB of disk, and needs ~12 GB free to start."
        ;;
esac
print ""
print -r -- "$detail"
if [[ -n $requires ]]; then
    # Names the builder as a command to run, not as the image's name — the old
    # "Requires the image to exist: claude-docker-build-arm" read as a tag.
    print -r -- "Requires: the image built by $requires — run that first if it is missing."
fi
print ""
# Never point a command at itself.
local -a see_also=(claude-docker-doctor claude-docker-status tupperclaude)
see_also=(${see_also:#$cmd})
print -r -- "See also: ${(j:, :)see_also}"
return 0
