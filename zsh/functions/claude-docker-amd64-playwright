#!/usr/bin/env zsh
# Run Claude Code in the linux/amd64 browser-capable (Playwright) container:
# native on Intel Macs, QEMU-emulated on Apple Silicon. The base amd64 image
# must already be built. Extra args pass through to claude.
#
# --help and --version are the WRAPPER's: `claude-docker-amd64-playwright -- --help`
# passes them to claude instead. Both are reserved because both are what people
# type at an unfamiliar command, and passing --version through would start a
# container, write MACHINE.md into the working directory and mint a tailnet node
# just to print a version string.

case "${1-}" in
    -h|--help)    _claude_docker_help claude-docker-amd64-playwright; return 0 ;;
    -v|--version) print -r -- "tupperclaude ${TUPPERCLAUDE_VERSION:-unknown}"; return 0 ;;
    --)           shift ;;
esac
_claude_docker_run amd64 playwright "$@"
