#!/usr/bin/env zsh
# Run Claude Code in the native linux/arm64 base container. Extra args pass through to claude.
#
# --help is the WRAPPER's: `claude-docker-arm -- --help` passes --help to claude.

[[ "${1-}" == (-h|--help) ]] && { _claude_docker_help claude-docker-arm; return 0 }
[[ "${1-}" == -- ]] && shift
_claude_docker_run arm64 base "$@"
