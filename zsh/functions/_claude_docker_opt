#!/usr/bin/env zsh
# _claude_docker_opt [-b] <key> <envvar> [default]
#
# Resolve one configuration option: zstyle → environment variable → default.
#
#   zstyle ':omz:plugins:tupperclaude' <key> <value>     highest precedence
#   $<envvar>                                            fallback
#   <default>                                            last resort
#
# The env-var layer lets one exported CLAUDE_DOCKER_* variable configure both
# this plugin and its fish sibling.
#
# Without -b: prints the resolved value on stdout, always returns 0.
# With -b:    prints nothing; returns 0 for true, 1 for false. A zstyle boolean
#             uses `zstyle -t` semantics (true|yes|on|1); an env var is true
#             when set to anything other than empty|no|off|false|0.
#
# Resolves at call time, so `zstyle` lines take effect wherever they appear in
# .zshrc.

emulate -L zsh
# noksharrays:  KSH_ARRAYS would change ${(P)...} indexing behaviour below.
# extendedglob: for the (#i) case-insensitive flag on the falsey-value patterns.
setopt local_options noksharrays extendedglob

local boolean=0
if [[ $1 == -b ]]; then
    boolean=1
    shift
fi

local key=$1 envvar=$2 default=$3
local -r ns=':omz:plugins:tupperclaude'

if (( boolean )); then
    zstyle -t "$ns" "$key"
    case $? in
        0) return 0 ;;   # explicitly true
        1) return 1 ;;   # explicitly something else
    esac                 # 2 = not set, fall through

    # ${(P)envvar} indirects through the variable name; ${(P)+envvar} tests
    # whether that named variable exists.
    if (( ${(P)+envvar} )); then
        local v=${(P)envvar}
        # (#i) is case-insensitive: users type `No`, `Off`, `False`.
        [[ -n $v && $v != (#i)(no|off|false|0) ]]
        return $?
    fi

    [[ -n $default && $default != (#i)(no|off|false|0) ]]
    return $?
fi

local value
if zstyle -s "$ns" "$key" value && [[ -n $value ]]; then
    print -r -- "$value"
    return 0
fi

if (( ${(P)+envvar} )) && [[ -n ${(P)envvar} ]]; then
    print -r -- "${(P)envvar}"
    return 0
fi

print -r -- "$default"
