#!/usr/bin/env zsh
# claude-ts-ensure [container-name] [tailnet-hostname]
#
# Ensure a persistent Tailscale sidecar is running, so a claude-docker container
# can join its network namespace with `--network=container:<name>` and reach the
# tailnet transparently.
#
# Kernel networking (TS_USERSPACE=false) needs NET_ADMIN + /dev/net/tun, which
# Docker Desktop's Linux VM provides. The sidecar holds the tunnel and the
# privileges; the claude container that joins it stays unprivileged.
#
# The node is persistent: state lives in a named volume so the same node
# re-appears across restarts instead of churning the admin console. The auth key
# is only consumed on first creation — use a reusable, tagged key.

emulate -L zsh
# noksharrays: array expansion below (_tc_check_fix, health) assumes 1-based
# zsh indexing.
setopt local_options noksharrays

local ts_name="${1:-claude-ts}"
local ts_host_in="${2:-}"
local cfg="${CLAUDE_DOCKER_HOME:-$HOME/.config/claude-docker}"

# The joined container keeps its own /etc/resolv.conf, so MagicDNS names won't
# resolve unless we point it at the tailnet resolver (100.100.100.100). MagicDNS
# forwards non-tailnet queries upstream; 1.1.1.1 is a fallback for when MagicDNS
# is off/down, and timeout:1 attempts:1 bounds the penalty in that case. The
# claude-docker images mount this read-only.
mkdir -p "$cfg"
printf 'nameserver 100.100.100.100\nnameserver 1.1.1.1\noptions timeout:1 attempts:1\n' \
    >"$cfg/tailscale-resolv.conf"

# The sidecar owns tailscaled; containers that join its netns need its control
# socket too, or the `tailscale` CLI has nothing to talk to. TS_SOCKET moves the
# socket into a named volume that the claude container mounts at
# /var/run/tailscale (tailscaled chmods it 0666 and authorises by peer creds, so
# an unprivileged user can still run read-only commands).
local sock_vol="claude-ts-sock-$ts_name"

# A sidecar created before this existed has no socket volume — drop it so the
# create path below rebuilds it. The node identity lives in the state volume,
# which survives, so this doesn't churn the admin console.
if command docker inspect "$ts_name" >/dev/null 2>&1; then
    if ! command docker inspect -f '{{range .Mounts}}{{.Name}} {{end}}' "$ts_name" | grep -q "$sock_vol"; then
        _claude_docker_warn "recreating Tailscale sidecar '$ts_name' to share its tailscaled socket…"
        command docker rm -f "$ts_name" >/dev/null
    fi
fi

# Running is NOT the same as connected. A sidecar that has lost its link to the
# coordination server keeps its 100.x address and still reports
# BackendState=Running, so a container joining its netns silently gets a tailnet
# that resolves nothing. Verify it is really online; a restart reliably
# re-establishes the netmap, and the node identity lives in the state volume so
# this costs nothing in the admin console.
local running
running="$(command docker inspect -f '{{.State.Running}}' "$ts_name" 2>/dev/null)"

if [[ "$running" == "true" ]]; then
    _claude_ts_online "$ts_name" 5 && return 0
    _claude_docker_warn "Tailscale sidecar '$ts_name' is running but offline — restarting…"
    command docker restart "$ts_name" >/dev/null
elif command docker inspect "$ts_name" >/dev/null 2>&1; then
    # Exists but stopped → start it.
    command docker start "$ts_name" >/dev/null
else
    # The value is resolved here (docker run needs the actual key), but the
    # diagnostic path is delegated to _claude_docker_check so the guidance text
    # for a missing/unresolvable key lives in one place.
    local authkey="${TS_AUTHKEY:-}"
    if [[ -z "$authkey" ]]; then
        if ! _claude_docker_check authkey; then
            _claude_docker_err "$_tc_check_detail" "${_tc_check_fix[@]}"
            return 1
        fi
        local ref
        ref="$(_claude_docker_opt op-ref CLAUDE_DOCKER_OP_TS_REF '')"
        authkey="$(command op read "$ref" 2>/dev/null)"
    fi

    # The tailnet hostname is cosmetic (the netns join uses the container name,
    # not this). Callers pass a clean, readable name; fall back to the container
    # name otherwise. A Tailscale hostname is a DNS label capped at 63 bytes, so
    # hash-truncate anything longer rather than fail to come up.
    local ts_host="${ts_host_in:-$ts_name}"
    if (( ${#ts_host} > 63 )); then
        local h="$(printf '%s' "$ts_host" | command shasum | cut -c1-8)"
        ts_host="${ts_host[1,54]}-$h"
    fi

    print -u2 "claude-ts-ensure: creating Tailscale sidecar '$ts_name'…"
    command docker run -d --name "$ts_name" --restart unless-stopped \
        --cap-add=net_admin --cap-add=net_raw \
        --device=/dev/net/tun \
        -v "claude-ts-state-$ts_name":/var/lib/tailscale \
        -v "$sock_vol":/tmp/tailscale-sock \
        -e TS_AUTHKEY="$authkey" \
        -e TS_STATE_DIR=/var/lib/tailscale \
        -e TS_SOCKET=/tmp/tailscale-sock/tailscaled.sock \
        -e TS_USERSPACE=false \
        -e TS_ACCEPT_DNS=true \
        -e TS_EXTRA_ARGS=--accept-routes \
        -e TS_HOSTNAME="$ts_host" \
        tailscale/tailscale:latest >/dev/null || return 1
fi

# Wait for the node to be genuinely online — not merely to have an address.
_claude_ts_online "$ts_name" 45 && return 0

local -a health
health=("${(f)$(command docker exec "$ts_name" tailscale status --json 2>/dev/null \
    | command jq -r '.Health[]? | "  health: " + .')}")
_claude_docker_err "Tailscale sidecar '$ts_name' did not come online within 45s." \
    "${health[@]}" "docker logs $ts_name"
