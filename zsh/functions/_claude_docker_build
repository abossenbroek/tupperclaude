#!/usr/bin/env zsh
# _claude_docker_build <arch>
#
# Build the claude-code-full-<arch> image. <arch> is arm64 or amd64.
#
# The image bakes in a whitelist of the host's non-secret Claude Code config
# (~/.claude.json, CLAUDE.md, settings.json, skills, commands, plugins) so a
# container starts with the same setup as the host. Secrets are NOT baked: the
# credentials file and all cloud/SSH credentials are mounted at run time.

emulate -L zsh
setopt local_options

local arch="$1"
local platform="linux/$arch"
local image="claude-code-full-$arch"
local plugin_dir="${CLAUDE_DOCKER_PLUGIN_DIR:-${0:A:h:h}}"
local dockerfile="${CLAUDE_DOCKER_DOCKERFILE:-$plugin_dir/docker/Dockerfile}"

if [[ ! -f "$dockerfile" ]]; then
    print -u2 "ERROR: Dockerfile not found at $dockerfile"
    print -u2 "       Set CLAUDE_DOCKER_DOCKERFILE to point at one."
    return 1
fi

if [[ ! -f "$HOME/.claude.json" ]]; then
    print -u2 "ERROR: ~/.claude.json not found — run 'claude' on the host once first."
    return 1
fi

if ! jq . "$HOME/.claude.json" >/dev/null 2>&1; then
    print -u2 "ERROR: ~/.claude.json is not valid JSON"
    return 1
fi

# Building an amd64 image on Apple Silicon works, but every RUN executes under
# QEMU emulation. Say so up front rather than let it look like a hang.
if [[ "$arch" == "amd64" && "$(uname -m)" == "arm64" ]]; then
    print "Note: cross-building linux/amd64 on Apple Silicon — RUN steps are QEMU-emulated and slow."
fi

local tmpdir
tmpdir="$(mktemp -d)" || return 1
local settings_dir="$tmpdir/claude-settings"
mkdir -p "$settings_dir/plugins/marketplaces" "$settings_dir/plugins/cache" \
         "$settings_dir/skills" "$settings_dir/commands"

# Copy the non-secret config whitelist into the build context.
cp "$HOME/.claude.json" "$tmpdir/claude.json"

# The host config runs MCP servers via macOS Homebrew paths (e.g.
# /opt/homebrew/bin/uvx), which do not exist in the Linux image. Rewrite them to
# the container paths the Dockerfile installs.
_claude_docker_sed_i 's#/opt/homebrew/bin/uvx#/usr/local/bin/uvx#g' "$tmpdir/claude.json"
_claude_docker_sed_i 's#/opt/homebrew/bin/uv#/usr/local/bin/uv#g'   "$tmpdir/claude.json"

cp    "$HOME/.claude/CLAUDE.md"      "$settings_dir/CLAUDE.md"      2>/dev/null
cp    "$HOME/.claude/settings.json"  "$settings_dir/settings.json"  2>/dev/null
cp -R "$HOME/.claude/skills/."       "$settings_dir/skills/"        2>/dev/null
cp -R "$HOME/.claude/commands/."     "$settings_dir/commands/"      2>/dev/null
cp -R "$HOME/.claude/plugins/marketplaces/." "$settings_dir/plugins/marketplaces/" 2>/dev/null
cp -R "$HOME/.claude/plugins/cache/."        "$settings_dir/plugins/cache/"        2>/dev/null

local f
for f in installed_plugins.json known_marketplaces.json plugin-catalog-cache.json; do
    cp "$HOME/.claude/plugins/$f" "$settings_dir/plugins/$f" 2>/dev/null
    # These files record absolute host paths; rewrite them to the container home.
    [[ -f "$settings_dir/plugins/$f" ]] && \
        _claude_docker_sed_i "s#$HOME/.claude#/home/agent/.claude#g" "$settings_dir/plugins/$f"
done

cp "$dockerfile" "$tmpdir/Dockerfile"

# The baked config is your own. Flag the one case that surprises people: an MCP
# server configured with an inline API key ends up inside the image layer.
if grep -qiE '"(api_?key|token|secret|password)"[[:space:]]*:' "$tmpdir/claude.json"; then
    print "Warning: ~/.claude.json contains key/token-looking fields; they will be baked into $image."
    print "         Keep this image local — do not push it to a shared or public registry."
fi

local build_date="$(date +%Y-%m-%dT%H:%M:%S)"
local -a build_args=(--build-arg "BUILD_DATE=$build_date")
if [[ -n "${CLAUDE_DOCKER_INCLUDE_AWS:-}" ]]; then
    build_args+=(--build-arg INCLUDE_AWS=1)
    print "Including AWS CLI v2 in the image (CLAUDE_DOCKER_INCLUDE_AWS is set)."
fi

print "Building $image ($platform)..."
docker build --platform "$platform" "${build_args[@]}" -t "$image" "$tmpdir"
local build_status=$?
rm -rf "$tmpdir"

if (( build_status != 0 )); then
    print -u2 "ERROR: Docker build failed"
    return 1
fi

docker image prune -f >/dev/null

print ""
print "Tool versions in $image:"
local -a tools=(
    "claude --version" "gh --version" "gcloud --version" "rg --version"
    "yq --version" "tmux -V" "uv --version" "psql --version" "mysql --version"
    "deno --version" "linear --version" "rustc --version" "cargo --version"
    "rust-analyzer --version" "pulumi version" "tailscale version"
)
[[ -n "${CLAUDE_DOCKER_INCLUDE_AWS:-}" ]] && tools+=("aws --version")

local tool
for tool in $tools; do
    docker run --rm --platform "$platform" "$image" ${=tool} 2>/dev/null | head -1
done

print ""
print "Success! $image built on $build_date"
