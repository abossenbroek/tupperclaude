#!/usr/bin/env zsh
# _claude_docker_run <arch> <variant> [claude args...]
#
# Run Claude Code in the container for <arch>/<variant> (see _claude_docker_ctx
# for the variant matrix), with the current directory bind-mounted at the same
# path. Networking is either a per-directory Tailscale sidecar or plain Docker
# bridge networking, per $_tc_network.

emulate -L zsh
setopt local_options nonomatch  # $PWD-derived paths may contain glob metacharacters

_claude_docker_ctx "$1" "$2" || return 1
shift 2

# Order matters: without docker on $PATH the image check also fails, and
# reporting that as "image not built" tells the user to run a build command
# that cannot work either. Diagnose the deepest missing prerequisite first,
# exactly as _claude_docker_build does.
_claude_docker_check docker-bin || {
    _claude_docker_err "docker is not installed" "${_tc_check_fix[@]}"
    return 1
}
_claude_docker_check docker-daemon || {
    _claude_docker_err "docker daemon is not reachable" "${_tc_check_fix[@]}"
    return 1
}
# $_tc_build_cmd rather than letting the check map the image name back to a
# command: ctx publishes it for exactly this reason.
_claude_docker_check image "$_tc_image" "$_tc_build_cmd" || {
    _claude_docker_err "$_tc_check_detail" "${_tc_check_fix[@]}"
    return 1
}

# The optional-tool options change what is IN the image, not its tag, so an
# image built before an option was flipped keeps serving every run silently. The
# build stamps the answer it used as a label; comparing it here is what makes
# that label more than write-only bookkeeping — without this you flip aws on,
# RUN (rather than rebuild), and get no AWS CLI with nothing said.
#
# A warning, not a failure: the image works, it just isn't what the option now
# says. And only when the label is actually present — images built before it
# existed report nothing, and blaming them for an invisible mismatch would make
# this noise on every launch.
local _tc_tool built want_label
for _tc_tool in $_tupperclaude_tools; do
    built="$(command docker image inspect \
        -f "{{index .Config.Labels \"$(_claude_docker_tool label $_tc_tool)\"}}" \
        "$_tc_image" 2>/dev/null)"
    [[ $built == (true|false) ]] || continue

    want_label=off
    _claude_docker_tool enabled $_tc_tool && want_label=on
    [[ $want_label == on && $built == true ]] && continue
    [[ $want_label == off && $built == false ]] && continue

    # WHICH command actually fixes this differs by variant, and naming the wrong
    # one makes the warning unactionable: these tools are installed by the base
    # Dockerfile alone, so the playwright image inherits the base's answer
    # (_claude_docker_build stamps its label from the base image's). Rebuilding
    # playwright therefore re-stamps the same value and the warning returns
    # forever. Point at the base builder instead.
    local tool_fix="$_tc_build_cmd"
    [[ $_tc_variant == playwright ]] \
        && tool_fix="${_tc_build_cmd%-playwright}    # the base image decides this; playwright inherits it"
    _claude_docker_warn "the $_tc_tool option is $want_label but ${_tc_image} was built with $_tc_tool=$built — the option takes effect on the next build, not on this run" \
        "$tool_fix"
done

# helm gets the same check for a sharper reason than the tools above: a missing
# binary announces itself, whereas the wrong helm major runs and renders charts
# against a live cluster. Only when k8s is on — with no toolchain in the image
# there is no helm for the option to be wrong about.
if _claude_docker_tool enabled k8s; then
    local built_helm
    built_helm="$(command docker image inspect \
        -f '{{index .Config.Labels "tupperclaude.helm"}}' "$_tc_image" 2>/dev/null)"
    # An unrecognised value counts as a mismatch rather than an error: the image
    # was built with something, and staying silent about it is the one wrong
    # answer. Images predating the label report nothing and are left alone.
    if [[ -n $built_helm ]]; then
        local want_helm
        want_helm="$(_claude_docker_opt helm CLAUDE_DOCKER_HELM 3)"
        if [[ $want_helm != $built_helm ]]; then
            local helm_fix="$_tc_build_cmd"
            [[ $_tc_variant == playwright ]] \
                && helm_fix="${_tc_build_cmd%-playwright}    # the base image decides this; playwright inherits it"
            _claude_docker_warn "the helm option is $want_helm but ${_tc_image} was built with helm=$built_helm — the option takes effect on the next build, not on this run" \
                "$helm_fix"
        fi
    fi
fi

# One container name per directory and variant, so a second run in the same
# directory collides on --name. Checked HERE, before the sidecar work and
# before MACHINE.md is rewritten: without this the user waits 30–45s, watches
# their working directory get modified, and is then handed Docker's own
# `Conflict. The container name "…" is already in use` — which names no
# tupperclaude command, so the obvious next move is `docker rm -f`, killing the
# live session they were trying not to disturb.
#
# -aq, not -q: docker reserves the name for STOPPED containers too, so checking
# only running ones leaves the exact raw conflict this guard exists to prevent.
# The two cases need different advice, so they are distinguished rather than
# merged — telling someone with a live session to `docker rm` it would be worse
# than saying nothing.
if [[ -n "$(command docker ps -aq --filter "name=^${_tc_name}\$" 2>/dev/null)" ]]; then
    if [[ -n "$(command docker ps -q --filter "name=^${_tc_name}\$" 2>/dev/null)" ]]; then
        _claude_docker_err "a sandbox is already running for $PWD ($_tc_arch/$_tc_variant, container '$_tc_name')" \
            'claude-docker-shell   # open a second shell in the running sandbox' \
            "docker attach $_tc_name   # or reattach to its tmux session" \
            'nothing has been changed — the running session is untouched'
    else
        # Sandboxes run with --rm, so a stopped one is residue from a daemon
        # that died mid-session, not somebody's work. Naming it exactly is what
        # keeps the fix from becoming a guessed `docker rm -f`.
        _claude_docker_err "a stopped container is holding the name '$_tc_name', so this sandbox cannot start" \
            "docker rm $_tc_name    # it is dead residue — sandboxes run with --rm" \
            'then re-run this command'
    fi
    return 1
fi

# Deliberately NO auth-key check here. The key is consumed only when a sidecar
# is created for the first time; an existing one restarts and reconnects from
# its state volume without ever reading it. claude-ts-ensure owns the check, in
# the branch that actually needs a key.

# Cold start is 10–45s of sidecar and image work with nothing on screen
# otherwise; say what is happening before going quiet.
_claude_docker_info "starting $_tc_arch/$_tc_variant sandbox for $PWD…"

# One state dir per working directory, so parallel sessions in different repos
# don't share teams/tasks/projects state.
#
# Every one of these is checked: a bind mount whose host path could not be
# created makes Docker create it instead — as root, and as a directory even
# where a file was meant. Failing here is recoverable; failing at `docker run`
# leaves root-owned litter in the user's config tree.
if ! command mkdir -p \
    "$_tc_state/teams" "$_tc_state/tasks" "$_tc_state/projects" \
    "$_tc_cfg/cargo" "$HOME/.claude/worktrees"
then
    _claude_docker_err "could not create the sandbox state directories under ${_tc_cfg:q}" \
        "ls -ld ${_tc_cfg:q}"
    return 1
fi

if ! command touch "$_tc_cfg/.credentials.json"; then
    _claude_docker_err "could not create ${_tc_cfg:q}/.credentials.json" \
        "ls -ld ${_tc_cfg:q}"
    return 1
fi

# tmux/readline config and the session launcher live on the host and are mounted
# read-only, so changing them needs no image rebuild. print -r keeps the \n and
# \a sequences below literal, for the container's bash to interpret at run time.
#
# The brace group is what makes a failed redirection reportable: for a builtin,
# `printf … >bad 2>/dev/null` still lets the shell print its own error, and only
# wrapping the redirection in `{ } 2>/dev/null` suppresses it.
if ! { printf 'set -g mode-keys vi\nset -g status-keys vi\nset -sg escape-time 10\n' \
         >"$_tc_cfg/tmux.conf"
       printf 'set editing-mode vi\n' >"$_tc_cfg/inputrc" } 2>/dev/null
then
    _claude_docker_err "could not write the tmux/readline config under ${_tc_cfg:q}" \
        "ls -ld ${_tc_cfg:q}"
    return 1
fi

local -a net_args=()
local -a netwatch_mount=()

# The generated launcher's CONTENT depends on the network mode (three windows
# under tailscale, two without), so it must NOT live in the shared $_tc_cfg:
# two concurrent sessions in different directories, or the same directory in
# different network modes, would overwrite each other's launcher between the
# write and the container reading it. $_tc_state is per-directory.
local launcher="$_tc_state/tmux-launch.sh"
local netwatch="$_tc_state/netwatch.sh"

if [[ "$_tc_network" == tailscale ]]; then
    claude-ts-ensure "$_tc_ts_node" "$_tc_ts_host" "$_tc_cfg" || return 1

    net_args=(
        --network="container:$_tc_ts_node"
        -v "$_tc_cfg/tailscale-resolv.conf:/etc/resolv.conf:ro"
        -v "claude-ts-sock-$_tc_ts_node:/var/run/tailscale"
    )

    # Liveness probe for window 2. Control plane = the sidecar's own view of the
    # tailnet; data plane = DNS + egress through its netns. Both matter: the node
    # keeps its 100.x address and BackendState=Running after losing the netmap.
    if ! { print -r -l >"$netwatch" \
        '#!/bin/bash' \
        'last=""; beat=0' \
        'while true; do' \
        '    online=$(tailscale status --json 2>/dev/null | jq -r ".Self.Online // \"unknown\"")' \
        '    if curl -s -o /dev/null -m 8 https://login.tailscale.com/; then egress=ok; else egress=FAIL; fi' \
        '    state="$online/$egress"' \
        '    if [ "$state" != "$last" ]; then' \
        '        printf "%s  tailnet=%s egress=%s\n" "$(date +%H:%M:%S)" "$online" "$egress"' \
        '        if [ "$state" != "true/ok" ]; then' \
        '            printf "\a  degraded:\n"' \
        '            tailscale status --json 2>/dev/null | jq -r ".Health[]? | \"    \" + ."' \
        '            printf "    restarting the sidecar will NOT heal this container (its netns goes stale).\n"' \
        '            printf "    exit claude and re-run the claude-docker command — it repairs the sidecar on launch.\n"' \
        '        fi' \
        '        last=$state' \
        '    elif [ $((beat % 4)) -eq 0 ]; then' \
        '        printf "%s  %s\n" "$(date +%H:%M:%S)" "$state"' \
        '    fi' \
        '    beat=$((beat + 1))' \
        '    sleep 15' \
        'done' } 2>/dev/null
    then
        _claude_docker_err "could not write ${netwatch:q}" "ls -ld ${_tc_state:q}"
        return 1
    fi

    netwatch_mount=(-v "$netwatch:/run/netwatch.sh:ro")
fi

# ---- the tmux window set ----------------------------------------------------
#
# Window 0 is ALWAYS claude, is created first from the command actually invoked,
# and is selected again before attach — so however many tool windows get added
# below, attaching lands you in Claude. Everything else is appended after it and
# never reorders it.
#
# With every option on the set is:
#
#   [claude] [aws] [gcloud] [k9s] [tailscale] [zsh]
#
# The auth windows PRE-TYPE their command without executing it. That is the whole
# design and not a half-measure: the only thing you do is press Enter, and once
# you have, the command is in that shell's history — so when the lease expires
# an hour later you press Up and Enter rather than remembering the flag soup.
# Executing it for you would be worse: these commands print a URL and block, and
# they are exactly the commands you sometimes want to edit first (a different
# --profile, a different account) before they run.
#
# k9s and the tailnet monitor are RUN, not pre-typed: a TUI and a watcher have
# nothing to decide, so pre-typing them would just be an Enter you always press.
local -a launch=(
    '#!/bin/bash'
    'tmux new-session -d -s main -n claude "$@"'
)

# One `sleep 1` for the whole launcher, not one per window: bash must paint its
# prompt before any send-keys arrives, or the pre-typed line renders twice.
local -a pretyped=()

if _claude_docker_tool enabled aws; then
    launch+=('tmux new-window -t main: -n aws')
    # --no-browser: there is no browser in the container to open, and without
    # the flag the CLI waits on one before falling back to printing the URL.
    pretyped+=("tmux send-keys -t main:aws 'aws sso login --no-browser'")
fi

if _claude_docker_tool enabled gcloud; then
    launch+=('tmux new-window -t main: -n gcloud')
    pretyped+=("tmux send-keys -t main:gcloud 'gcloud auth login --update-adc --no-launch-browser && gcloud auth application-default login --no-launch-browser'")
fi

if _claude_docker_tool enabled k8s; then
    # Wrapped, because a tmux window dies with its command: with no reachable
    # cluster k9s exits at once, the window vanishes, and the option looks like
    # it never installed. The wrapper keeps the error on screen and leaves a
    # shell behind. netwatch needs none of this — it loops forever.
    launch+=("tmux new-window -t main: -n k9s bash -c 'k9s; printf \"\\nk9s exited — Enter for a shell\\n\"; exec bash'")
fi

if [[ "$_tc_network" == tailscale ]]; then
    launch+=('tmux new-window -t main: -n tailscale bash /run/netwatch.sh')
fi

# A tmux window dies with its command, so images predating zsh need the fallback.
# `command -v` rather than `exec zsh || exec bash`: a failed exec terminates the
# shell instead of returning non-zero.
launch+=("tmux new-window -t main: -n zsh bash -c 'command -v zsh >/dev/null && exec zsh || exec bash'")

if (( ${#pretyped} )); then
    launch+=('# Let bash paint its prompt first, or the pre-typed line renders twice.' 'sleep 1')
    launch+=("${pretyped[@]}")
fi

launch+=(
    'tmux select-window -t main:claude'
    'exec tmux attach -t main'
)

if ! print -r -l -- "${launch[@]}" >"$launcher" 2>/dev/null; then
    _claude_docker_err "could not write ${launcher:q}" "ls -ld ${_tc_state:q}"
    return 1
fi

# Tell Claude what kind of machine it is running on.
#
# The marker line records which sandbox wrote the file, so a MACHINE.md left
# behind by a base run gets refreshed rather than keep telling Claude it has no
# browser after switching to the playwright variant. A MACHINE.md this function
# did not write is somebody's own document and is never touched.
#
# Ownership is decided by the SHAPE of the marker line, not by whether the word
# "tupperclaude" appears somewhere in the file. It used to be the latter, which
# meant a colleague's own notes that merely mentioned tupperclaude — or any file
# containing the sentence we happen to open with — authorised overwriting a file
# in their repo, flatly contradicting the promise made just above.
local machine_md="$PWD/MACHINE.md"
# The marker records everything the BODY depends on, not just the image. The
# body names the optional toolchains, so without them here two runs in the same
# directory with different options produce different bodies but an identical
# marker — the refresh short-circuits and Claude keeps reading a stale tool list.
local tool_marker=''
for _tc_tool in $_tupperclaude_tools; do
    _claude_docker_tool enabled $_tc_tool && tool_marker+=" $_tc_tool"
done
_claude_docker_tool enabled k8s && tool_marker+=" helm$(_claude_docker_opt helm CLAUDE_DOCKER_HELM 3)"
local marker="<!-- tupperclaude: $_tc_image $_tc_variant $_tc_network$tool_marker -->"
local net_desc
if [[ "$_tc_network" == tailscale ]]; then
    net_desc="a per-directory Tailscale sidecar; the container has full tailnet access"
else
    net_desc="plain Docker bridge networking (no Tailscale sidecar)"
fi

# Default ON — this file is announced when written and documented as safe to
# delete. The opt-out exists because a first run otherwise mutates whatever
# repository the user happens to be standing in, which is not a thing a
# colleague trying the tool once should have to undo.
integer write_machine_md=1
_claude_docker_opt -b machine-md CLAUDE_DOCKER_MACHINE_MD 1 || write_machine_md=0

# Set when the file in this directory is OURS — either written below, or left
# by an earlier run of this same sandbox. It is what licenses the removal after
# the container exits; a file we did not write is never ours to delete.
integer machine_md_ours=0

if (( write_machine_md )) && [[ -f "$machine_md" ]]; then
    if command grep -qF -- "$marker" "$machine_md"; then
        # Already describes exactly this sandbox — nothing to say.
        write_machine_md=0
        machine_md_ours=1
    elif ! command grep -qE '^<!-- tupperclaude: .* -->$' "$machine_md"; then
        # Ours would carry a marker line even if it names a different sandbox;
        # this one carries none, so it is not ours to rewrite.
        write_machine_md=0
    fi
fi

# Built once, as an array, and used twice: written below, and compared against
# the file on disk after the container exits. Two copies of this text would mean
# an edit to one silently stopping the cleanup from ever recognising its own
# output — the file would simply start accumulating again, with nothing failing.
# Both sentences below name the optional toolchains, so both are assembled from
# what this image actually has. Claiming a tool Claude does not have costs it a
# failed command and a wrong theory about why.
local md_creds='SSH, GitHub CLI (`gh`), Linear, Pulumi'
local md_tools='claude, gh, tailscale (CLI only — the daemon runs in the sidecar), docker, git, node/npm/pnpm/yarn/bun, python3/uv, php/composer, rustc/cargo, deno, psql, mysql, tmux, ripgrep, yq, pulumi, mise, linear'
if _claude_docker_tool enabled aws; then
    md_creds+=', AWS'
    md_tools+=', aws'
fi
if _claude_docker_tool enabled gcloud; then
    md_creds+=', Google Cloud (`gcloud`)'
    md_tools+=', gcloud'
fi
if _claude_docker_tool enabled k8s; then
    md_creds+=', Kubernetes (`~/.kube/config`, writable in here — logging into another cluster does not touch the host)'
    md_tools+=", kubectl, k9s, helm ($(_claude_docker_opt helm CLAUDE_DOCKER_HELM 3))"
fi

local -a machine_md_body=(
    "$marker"
    '# Machine'
    ''
    "This directory runs inside a Docker container (\`$_tc_image\`, native \`$_tc_platform\`, $_tc_variant variant)."
    ''
    '- **Working directory** is bind-mounted from the macOS host at the same path — file edits are live on both sides.'
    "- **Networking** is provided by $net_desc."
    "- **Credentials** are copied in at startup: ${md_creds}."
    "- **Tools available:** ${md_tools}."
    '- **Cargo cache** and Claude credentials are shared across all claude-docker sessions; teams/tasks/projects state is per-directory.'
    '- **mise** — all `mise.toml` / `.mise.toml` / `.mise/config.toml` files are pre-trusted; never prompt for mise trust confirmation.'
)

if (( write_machine_md )); then
    if print -r -l -- "${machine_md_body[@]}" >"$machine_md" 2>/dev/null
    then
        machine_md_ours=1
        _claude_docker_info "wrote MACHINE.md (describes this sandbox to Claude; removed on exit if you leave it unedited)"
    else
        # Not fatal: a read-only checkout still runs perfectly well, Claude just
        # doesn't get the description. Never let this abort the launch.
        _claude_docker_warn "could not write ${machine_md:q} — Claude will not be told about the sandbox" \
            "ls -ld ${PWD:q}"
    fi
fi

local -a mounts=()

# Host credential stores, mounted read-only at /run/host-* and copied into place
# by start.sh. Only mount what exists — a bind mount of a missing path makes
# Docker create a root-owned empty directory on the host.
local -a cred_dirs=(
    "$HOME/.ssh"           /run/host-ssh
    "$HOME/.config/gh"     /run/host-gh
    "$HOME/.config/gcloud" /run/host-gcloud
    "$HOME/.config/linear" /run/host-linear
    "$HOME/.pulumi"        /run/host-pulumi
    "$HOME/.aws"           /run/host-aws
)
local src dst
for src dst in "${cred_dirs[@]}"; do
    [[ -d "$src" ]] && mounts+=(-v "$src:$dst:ro")
done

# The kubeconfig is a FILE mount, alone among these: the rest of ~/.kube is a
# discovery cache keyed by API-server IP — an inventory of every cluster this
# host has ever contacted, which outlives the kubeconfig entries themselves —
# plus a cached GKE access token. The sandbox needs none of it, and start.sh
# copies the file to a writable ~/.kube/config so logging into a different
# cluster in here never reaches the host's.
#
# Gated on the option rather than the image label, so that "no k9s window" and
# "no kubeconfig" always travel together; an image built without the toolchain
# already earns the mismatch warning above.
if _claude_docker_tool enabled k8s; then
    local kubeconfig="$HOME/.kube/config"
    # KUBECONFIG may list several paths; merging them is kubectl's job, not
    # ours, and picking the first would silently drop the rest. Fall back and
    # say so instead of guessing.
    if [[ -n ${KUBECONFIG:-} ]]; then
        if [[ $KUBECONFIG == *:* ]]; then
            _claude_docker_warn "KUBECONFIG lists several files; mounting ~/.kube/config instead" \
                'unset KUBECONFIG, or point it at a single file, to mount that one'
        elif [[ $KUBECONFIG != /* ]]; then
            # A relative path would still pass the -f test below, then reach
            # docker as `-v ./kubeconfig:...`, which it rejects with a message
            # about neither an absolute path nor a valid volume name.
            _claude_docker_warn "KUBECONFIG is a relative path; mounting ~/.kube/config instead" \
                "point KUBECONFIG at an absolute path to mount that one: ${KUBECONFIG:a}"
        else
            kubeconfig="$KUBECONFIG"
        fi
    fi
    [[ -f "$kubeconfig" ]] && mounts+=(-v "$kubeconfig:/run/host-kube/config:ro")
fi

# Docker Desktop for Mac forwards the host ssh-agent at this fixed path.
#
# Mounted UNCONDITIONALLY and deliberately so: /run/host-services/ssh-auth.sock
# does not exist on the macOS host filesystem — it lives inside Docker Desktop's
# Linux VM, which synthesises it for the container. Guarding this with a
# `[[ -S ... ]]` test looks correct but always fails on macOS, silently dropping
# the mount and breaking SSH agent forwarding (and therefore `git push`) inside
# the container. Do not "fix" this into a conditional.
mounts+=(-v /run/host-services/ssh-auth.sock:/ssh-agent)
# THE DOCKER SOCKET IS HOST-ROOT-EQUIVALENT. Anything that can talk to it can
# start a privileged container with the host filesystem mounted, so this mount
# means the container is NOT a security boundary against the code running in
# it: a malicious dependency, or an agent that goes wrong, can own the machine.
#
# It is on by default because that is the honest description of what this tool
# has always been — a reproducible, disposable *environment* whose isolation is
# about not polluting the host, not about containing hostile code — and because
# MACHINE.md advertises `docker` to Claude as an available tool. Turning it off
# silently would break every workflow that builds or runs containers inside the
# sandbox.
#
# Set `docker-sock` off to get a real boundary, at the cost of docker-in-the-
# sandbox. The README says the same thing in the same words.
#
# --group-add 0 travels WITH the mount and only with it. gid 0 is what lets the
# agent user read the socket, whose group inside Docker Desktop's VM is root; it
# is meaningless without the socket, and passing it anyway would hand gid 0 to
# the container in exactly the configuration a user chose in order to tighten
# it. It used to sit unconditionally in the argv below, which made the README's
# claim that it "accompanies the mount" false, and which no test would have
# caught — this option had no coverage in either state until the assertions in
# test-run-args.zsh that accompany this comment.
local -a sock_args=()
if _claude_docker_opt -b docker-sock CLAUDE_DOCKER_DOCKER_SOCK 1; then
    if [[ -S /var/run/docker.sock ]]; then
        mounts+=(-v /var/run/docker.sock:/var/run/docker.sock)
        sock_args=(--group-add 0)
    fi
fi

# In a git worktree, also mount the main checkout so git can follow the .git
# file's gitdir pointer out of the working directory.
#
# --porcelain, not the human format: `git worktree list` prints
# `<path> <sha> [branch]` with no quoting, so awk '{print $1}' truncates a
# checkout under `~/my repo` to `/Users/…/my` — a path that does not exist and
# that Docker would then create, root-owned. The porcelain form puts the path
# alone on its own `worktree <path>` line.
local main_repo
main_repo="$(command git worktree list --porcelain 2>/dev/null \
    | command sed -n '1s/^worktree //p')"
# Compare resolved paths: on macOS git reports /private/var while $PWD says
# /var, and a textual compare would mount the working directory a second time.
[[ -n "$main_repo" && "${main_repo:A}" != "${PWD:A}" ]] && mounts+=(-v "$main_repo:$main_repo")

command docker run -it --rm \
    --platform "$_tc_platform" \
    `# Empty unless the docker socket is actually mounted — see sock_args above.` \
    "${sock_args[@]}" \
    --name "$_tc_name" \
    --label "tupperclaude.dir=$PWD" \
    --label "tupperclaude.arch=$_tc_arch" \
    --label "tupperclaude.variant=$_tc_variant" \
    "${net_args[@]}" \
    -v "$PWD":"$PWD" \
    -v "$_tc_cfg/.credentials.json":/home/agent/.claude/.credentials.json \
    -v "$_tc_state/teams":/home/agent/.claude/teams \
    -v "$_tc_state/tasks":/home/agent/.claude/tasks \
    -v "$_tc_state/projects":/home/agent/.claude/projects \
    -v "$HOME/.claude/worktrees":"$HOME/.claude/worktrees" \
    -v "$_tc_cfg/cargo":/home/agent/.cargo \
    -v "$_tc_cfg/tmux.conf":/home/agent/.tmux.conf:ro \
    -v "$_tc_cfg/inputrc":/home/agent/.inputrc:ro \
    -v "$launcher":/run/tmux-launch.sh:ro \
    "${netwatch_mount[@]}" \
    "${mounts[@]}" \
    -e SSH_AUTH_SOCK=/ssh-agent \
    -e TERM=xterm-256color \
    -e LANG=en_US.UTF-8 \
    -e LC_ALL=en_US.UTF-8 \
    -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
    -e LINEAR_API_KEY="${LINEAR_API_KEY:-}" \
    -e GEMINI_API_KEY="${GEMINI_API_KEY:-}" \
    -e OPENAI_API_KEY="${OPENAI_API_KEY:-}" \
    -e PULUMI_ACCESS_TOKEN="${PULUMI_ACCESS_TOKEN:-}" \
    -e MISE_TRUSTED_CONFIG_PATHS="$PWD/mise.toml:$PWD/.mise.toml:$PWD/.mise/config.toml" \
    "${_tc_run_flags[@]}" \
    -w "$PWD" \
    "$_tc_image" \
    /usr/local/bin/start.sh bash /run/tmux-launch.sh claude --teammate-mode in-process "$@"
integer run_status=$?

# ---- MACHINE.md cleanup -----------------------------------------------------
# The file exists to describe the sandbox to Claude; once the sandbox is gone it
# is stale litter in someone's repository, and until now nothing removed it —
# not the run path, not claude-docker-clean. Left to accumulate, one per
# directory ever used.
#
# Three interlocks, all required, because this deletes a file in the user's
# working directory:
#
#   1. $machine_md_ours — we wrote it, or an earlier run of this exact sandbox
#      did. A file with no marker, or someone else's own MACHINE.md, is never
#      touched (same promise the write path makes).
#   2. Byte-identical to what we would write. This is what "unedited" means:
#      if Claude or the user changed a single character, the edit is theirs and
#      it stays. Subsumes the marker check — content equality implies it.
#   3. No other sandbox is still running in this directory. Two sessions in one
#      directory would otherwise have the first to exit delete the file out from
#      under the second, which still needs it. Our own container is already gone
#      (--rm), so anything this finds belongs to somebody else.
if (( machine_md_ours )) && [[ -f "$machine_md" ]]; then
    local machine_md_now
    machine_md_now="$(<"$machine_md")"
    if [[ "$machine_md_now" == "${(F)machine_md_body}" ]]; then
        local others
        others="$(command docker ps -q --filter "label=tupperclaude.dir=$PWD" 2>/dev/null)"
        if [[ -z $others ]]; then
            command rm -f -- "$machine_md"
        fi
    fi
fi

return $run_status
