#!/usr/bin/env zsh
# claude-docker-shell [-h|--help] [cmd...]
#
# Open an extra shell inside the sandbox already running for the current
# directory, without disturbing its tmux session. With no arguments this
# runs an interactive bash; any arguments are exec'd inside the container
# instead.

emulate -L zsh
# noksharrays: the indexing below assumes 1-based zsh indexing.
setopt local_options noksharrays

local usage='usage: claude-docker-shell [-h|--help] [cmd...]'

# Only a bare -h/--help as the FIRST argument is help: everything after the
# first argument belongs to the command being run inside the container, and
# `claude-docker-shell claude --help` must reach claude, not this function.
case ${1:-} in
    -h|--help)
        print -r -l -- \
            "$usage" \
            '' \
            'Open a second shell inside the sandbox already running for the current' \
            'directory, leaving its tmux session alone. With arguments, run them in' \
            'the container instead of starting an interactive shell.' \
            '' \
            '  -h, --help   show this help' \
            '' \
            '  claude-docker-shell                 interactive bash' \
            "  claude-docker-shell git status      run one command" \
            '' \
            'A TTY is allocated only when stdin is one, so this works from a script' \
            'or a pipeline.' \
            '' \
            'See also: claude-docker-status (what is running, where).'
        return 0
        ;;
esac

# Reporting "no sandbox is running" when the daemon is simply unreachable
# sends the user off to start one, which will fail for a different reason.
if ! _claude_docker_check docker-bin; then
    _claude_docker_err "docker: $_tc_check_detail" "${_tc_check_fix[@]}"
    return 1
fi
if ! _claude_docker_check docker-daemon; then
    _claude_docker_err "the Docker daemon is $_tc_check_detail" "${_tc_check_fix[@]}"
    return 1
fi

local -a matches
matches=(${(f)"$(command docker ps --filter "label=tupperclaude.dir=$PWD" --format '{{.ID}}'$'\t''{{.Names}}')"})

if (( ${#matches} == 0 )); then
    _claude_docker_err "no sandbox is running for $PWD" \
        "claude-docker-arm     # start one (or claude-docker-amd64)" \
        "claude-docker-status  # see what is running elsewhere"
    return 1
fi

if (( ${#matches} > 1 )); then
    local -a fixes
    local m
    for m in "${matches[@]}"; do
        fixes+=("docker exec -it ${m##*$'\t'} bash")
    done
    _claude_docker_err "multiple sandboxes are running for $PWD — run one of:" "${fixes[@]}"
    return 1
fi

local id="${matches[1]%%$'\t'*}"

# Allocate a TTY only when we actually have one. `docker exec -t` against a
# non-terminal stdin fails outright with "cannot attach stdin to a TTY-enabled
# container", which would break every scripted use — `claude-docker-shell -c
# '...'` from a script, a pipeline, or CI.
local -a exec_flags=(-i)
[[ -t 0 ]] && exec_flags+=(-t)

if (( $# > 0 )); then
    command docker exec "${exec_flags[@]}" "$id" "$@"
else
    command docker exec "${exec_flags[@]}" "$id" bash
fi
