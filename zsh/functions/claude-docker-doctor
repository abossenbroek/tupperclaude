#!/usr/bin/env zsh
# claude-docker-doctor [-h|--help] [--version]
#
# Aggregate every predicate in _claude_docker_check into one report: an
# aligned ok/FAIL/info column, the detail, and — for anything that needs
# attention — the copy-pasteable fix indented underneath. Modelled on p10k's
# detect → explain → copy-pasteable-command shape.
#
# "info" (as opposed to "FAIL") marks checks that most setups will
# legitimately not have: the playwright images (most users only need base),
# the foreign-architecture images (a machine that has never cross-built is
# healthy), and op-signin (only relevant if an op-ref is configured at all).
# Everything else is required, and a required failure makes this exit
# non-zero.
#
# The report is printed in two sections — environment checks, then images —
# because a single column wide enough for `claude-code-full-playwright-arm64`
# leaves a 30-character gap after `jq`. Each section aligns among itself.
#
# This command must survive a configuration it is being asked to diagnose, so
# it never aborts on a bad option: an invalid `network` is reported as a failed
# check, and the image-name lookups deliberately ignore it.
#
# Also prints TUPPERCLAUDE_VERSION and the resolved configuration, so a bug
# report can just paste the whole thing.

emulate -L zsh
# noksharrays:  this file indexes checks_* arrays with 1-based zsh semantics.
# extendedglob: for the `[[:space:]]#` (zero-or-more) trim in the render loop.
setopt local_options noksharrays extendedglob

local usage='usage: claude-docker-doctor [-h|--help] [--version]'

case ${1:-} in
    -h|--help)
        print -r -l -- \
            "$usage" \
            '' \
            'Check every prerequisite for running a tupperclaude sandbox and print' \
            'an aligned report: ok / FAIL / info, plus a pasteable fix under any' \
            'line that needs one. Reports the resolved configuration too, so a bug' \
            'report can be the whole output.' \
            '' \
            'Exits non-zero only if a REQUIRED check failed. Missing playwright or' \
            'foreign-architecture images are informational.' \
            '' \
            '  -h, --help     show this help' \
            '      --version  print the tupperclaude version and exit' \
            '' \
            'See also: claude-docker-configure (interactive setup),' \
            '          claude-docker-status (what is running right now).'
        return 0
        ;;
    --version)
        print -r -- "tupperclaude ${TUPPERCLAUDE_VERSION:-unknown}"
        return 0
        ;;
    '') ;;
    *)
        _claude_docker_err "unknown argument '$1'" "$usage"
        return 1
        ;;
esac

print -r -- "tupperclaude v${TUPPERCLAUDE_VERSION:-unknown} — doctor"
print -r -- ""

# Every option _claude_docker_opt knows about is resolved here. This block is
# billed as "paste the whole thing into a bug report", so an option missing from
# it is an option nobody can be asked about — which is how `machine-md` and
# `dockerfile` came to be settable but invisible.
local network home_dir op_ref dockerfile aws_label=no machine_md_label=on
network="$(_claude_docker_opt network CLAUDE_DOCKER_NETWORK tailscale)"
home_dir="$(_claude_docker_opt home CLAUDE_DOCKER_HOME "$HOME/.config/claude-docker")"
op_ref="$(_claude_docker_opt op-ref CLAUDE_DOCKER_OP_TS_REF '')"
dockerfile="$(_claude_docker_opt dockerfile CLAUDE_DOCKER_DOCKERFILE '')"
_claude_docker_opt -b aws CLAUDE_DOCKER_INCLUDE_AWS && aws_label=yes
_claude_docker_opt -b machine-md CLAUDE_DOCKER_MACHINE_MD 1 || machine_md_label=off

# Build the check list. `checks_required[i]` distinguishes a real failure
# from something informational — see the file header for which is which.
# checks_arg2 carries the build command for the image rows, so the check does
# not have to map an image name back to one — ctx publishes $_tc_build_cmd for
# exactly that reason. Empty for every non-image row.
local -a checks_label checks_what checks_arg checks_arg2 checks_required
checks_label=(docker-bin docker-daemon jq claude-json network ssh-agent authkey)
checks_what=(docker-bin docker-daemon jq claude-json network ssh-agent authkey)
checks_arg=('' '' '' '' '' '' '')
checks_arg2=('' '' '' '' '' '' '')
# The Tailscale auth key only matters when the network mode actually uses
# Tailscale; in `default` network mode a missing key is not a real problem.
# Tested for `default` rather than "not tailscale" so an INVALID mode — which
# the network check above already fails on — doesn't also quietly demote this.
local authkey_required=1
[[ $network == default ]] && authkey_required=0
checks_required=(1 1 1 1 1 1 $authkey_required)

if [[ -n $op_ref ]]; then
    checks_label+=(op-signin)
    checks_what+=(op-signin)
    checks_arg+=('')
    checks_arg2+=('')
    checks_required+=(1)
fi

local first_image_row=$(( ${#checks_label} + 1 ))

# Image checks for the full variant matrix — _claude_docker_ctx is the single
# source of truth for image names, so ask it rather than deriving them here.
#
# It is asked in a subshell with the `network` option cleared: ctx rejects an
# invalid network mode, and doctor must still render its table for the user
# whose broken zstyle is the very thing they are here to find. The network mode
# has no bearing on an image name, so a known-good value costs nothing.
local host_arch=arm64
[[ "$(command uname -m)" == x86_64 ]] && host_arch=amd64
local arch variant image build_cmd
for arch in arm64 amd64; do
    for variant in base playwright; do
        # Image name AND build command in one round trip: two subshells would be
        # two chances for them to disagree about which variant they describe.
        read -r image build_cmd <<<"$(
            zstyle -d ':omz:plugins:tupperclaude' network
            unset CLAUDE_DOCKER_NETWORK
            _claude_docker_ctx "$arch" "$variant" >/dev/null 2>&1 \
                && print -r -- "$_tc_image $_tc_build_cmd"
        )"
        [[ -z $image ]] && continue
        checks_label+=("$image")
        checks_what+=(image)
        checks_arg+=("$image")
        checks_arg2+=("$build_cmd")
        # Only the base image for THIS host's architecture is required. A
        # machine that has never cross-built is perfectly healthy, so a missing
        # foreign-arch image — or any playwright image — is informational.
        # Without this, doctor exits non-zero on a completely correct setup.
        if [[ $variant == base && $arch == $host_arch ]]; then
            checks_required+=(1)
        else
            checks_required+=(0)
        fi
    done
done

# One column width per section, so the environment rows are not padded out to
# the width of the longest image tag.
local i env_width=0 image_width=0
for (( i = 1; i < first_image_row; i++ )); do
    (( ${#checks_label[i]} > env_width )) && env_width=${#checks_label[i]}
done
for (( i = first_image_row; i <= $#checks_label; i++ )); do
    (( ${#checks_label[i]} > image_width )) && image_width=${#checks_label[i]}
done

local any_required_failed=0
# The labels of the required checks that failed. In a report this long, with
# ok/FAIL/info interleaved across two sections, "see the fixes above" makes the
# user re-scan fifteen rows to find the two that matter.
local -a failed_labels
# "mark", not "status" — $status is a zsh special variable (alias for $?) and
# read-only.
local mark width detail
# Declared once, outside the loop: zsh 5.9 echoes `fix=<value>` to stdout when
# `local fix` re-declares a name that already holds a value in the same scope.
local fix
for (( i = 1; i <= $#checks_label; i++ )); do
    if (( i == first_image_row )); then
        print -r -- ""
        print -r -- "images:"
    fi
    width=$env_width
    (( i >= first_image_row )) && width=$image_width

    if _claude_docker_check "$checks_what[i]" "$checks_arg[i]" "$checks_arg2[i]"; then
        mark=ok
    elif (( checks_required[i] )); then
        mark=FAIL
        any_required_failed=1
        failed_labels+=("$checks_label[i]")
    else
        mark=info
    fi
    # An image check's detail leads with the image name, which the run path
    # needs in its one-line error but which is already the label here.
    detail=$_tc_check_detail
    (( i >= first_image_row )) && detail=${${detail#"$checks_arg[i]"}##[[:space:]]#}

    printf "  %-${width}s %-5s %s\n" "$checks_label[i]" "$mark" "$detail"
    if [[ $mark != ok ]]; then
        for fix in "${_tc_check_fix[@]}"; do
            printf '        %s\n' "$fix"
        done
    fi
done

print -r -- ""
print -r -- "config:"
printf '  %-11s %s\n' "version" "${TUPPERCLAUDE_VERSION:-unknown}"
printf '  %-11s %s\n' "network" "$network"
printf '  %-11s %s\n' "state root" "$home_dir"
printf '  %-11s %s\n' "aws" "$aws_label"
printf '  %-11s %s\n' "machine-md" "$machine_md_label"
[[ -n $op_ref ]] && printf '  %-11s %s\n' "op-ref" "$op_ref"
# Shown only when overridden: the default is a path inside the plugin, which is
# noise in every report where it has not been touched.
[[ -n $dockerfile ]] && printf '  %-11s %s\n' "dockerfile" "$dockerfile"

print -r -- ""
if (( any_required_failed )); then
    _claude_docker_err "required checks failed: ${(j:, :)failed_labels} — their fixes are indented under those rows above"
    return 1
fi
print -r -- "All required checks passed."
return 0
