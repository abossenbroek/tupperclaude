#!/usr/bin/env zsh
# _claude_docker_check <what> [arg] [arg2]
#
# One preflight predicate per concern. Returns 0 (pass) or 1 (fail), prints
# nothing, and publishes two globals the caller formats however it likes:
#
#   _tc_check_detail   short human-readable status (version, age, reason)
#   _tc_check_fix      array of copy-pasteable commands that would fix it
#
# Shared by claude-docker-doctor (which tabulates every check), the run path
# (which calls only the checks that gate the thing about to happen) and
# claude-docker-configure. Keeping the predicates here means a missing
# prerequisite is diagnosed identically wherever it is noticed.
#
# Checks:
#   docker-bin              docker is on $PATH
#   docker-daemon           the daemon answers
#   jq                      jq is on $PATH  (a hard runtime dependency)
#   image <image> [build-cmd]
#                           named image exists locally  (detail = age)
#   claude-json             ~/.claude.json exists and is valid JSON
#   network                 the configured network mode is one ctx accepts
#   authkey [node]          a Tailscale auth key is resolvable
#   op-signin               1Password CLI is available and unlocked
#   ssh-agent               Docker Desktop's ssh-agent socket is present

emulate -L zsh
setopt local_options noksharrays

local what=$1 arg=$2 arg2=$3
typeset -g _tc_check_detail=''
typeset -ga _tc_check_fix=()

case $what in

docker-bin)
    if (( ${+commands[docker]} )); then
        _tc_check_detail="$(command docker --version 2>/dev/null | head -1)"
        return 0
    fi
    _tc_check_detail='not found on $PATH'
    _tc_check_fix=('install Docker Desktop: https://docs.docker.com/desktop/install/mac-install/')
    return 1
    ;;

docker-daemon)
    if command docker info >/dev/null 2>&1; then
        _tc_check_detail='reachable'
        return 0
    fi
    _tc_check_detail='not reachable'
    _tc_check_fix=('open -a Docker    # then wait for it to finish starting')
    return 1
    ;;

jq)
    # Not optional: the sidecar health probe (_claude_ts_online), claude-ts-ensure
    # and the generated netwatch script all pipe through jq, so a machine without
    # it fails later, further from the cause.
    if (( ${+commands[jq]} )); then
        _tc_check_detail="$(command jq --version 2>/dev/null)"
        return 0
    fi
    _tc_check_detail='not found on $PATH'
    _tc_check_fix=('brew install jq')
    return 1
    ;;

image)
    local created
    if created="$(command docker image inspect -f '{{.Created}}' "$arg" 2>/dev/null)"; then
        _tc_check_detail="$arg  (built $created)"
        return 0
    fi
    _tc_check_detail="$arg not built"

    # <arg2> is the command that builds <arg>. Callers holding a context pass
    # $_tc_build_cmd, which _claude_docker_ctx publishes precisely so that the
    # variant matrix is written down in exactly one place — this used to map the
    # name back to a command itself, making it a fourth independent derivation.
    #
    # The fallback is for the callers that legitimately have no context because
    # they iterate over image NAMES (claude-docker-clean sweeping the machine).
    # It is the last remaining name→command mapping; give it a build command and
    # it goes away.
    local build_cmd=$arg2
    if [[ -z $build_cmd ]]; then
        build_cmd=claude-docker-build-arm
        [[ $arg == *amd64* ]] && build_cmd=claude-docker-build-amd64
        [[ $arg == *playwright* ]] && build_cmd="$build_cmd-playwright"
    fi

    if [[ $build_cmd == *-playwright ]]; then
        # The playwright image is built FROM the same-arch base, so a missing
        # playwright image usually means the base is missing too. Offer both, in
        # the order they must be run. Both names come from dropping the
        # playwright part off values that ctx produced — not a second matrix.
        local base_img=${arg/-playwright-/-}
        _tc_check_fix=()
        command docker image inspect "$base_img" >/dev/null 2>&1 \
            || _tc_check_fix+=("${build_cmd%-playwright}    # the playwright image is built FROM this")
        _tc_check_fix+=("$build_cmd")
    else
        _tc_check_fix=("$build_cmd")
    fi
    return 1
    ;;

claude-json)
    if [[ ! -f $HOME/.claude.json ]]; then
        _tc_check_detail='~/.claude.json not found'
        _tc_check_fix=('claude    # run Claude Code on the host once, then retry')
        return 1
    fi
    # Validity is decided by jq, so without jq we know nothing — say that,
    # rather than blaming the file. `command jq …` on a machine without jq
    # exits non-zero for exactly the same reason a malformed file does.
    if (( ! ${+commands[jq]} )); then
        _tc_check_detail='cannot validate: jq is not installed'
        _tc_check_fix=('brew install jq')
        return 1
    fi
    if command jq . "$HOME/.claude.json" >/dev/null 2>&1; then
        _tc_check_detail='valid JSON'
        return 0
    fi
    _tc_check_detail='~/.claude.json is not valid JSON'
    _tc_check_fix=('jq . ~/.claude.json    # shows where it is malformed')
    return 1
    ;;

network)
    # The same values _claude_docker_ctx accepts. Checked separately so a typo
    # in the zstyle is reported as one failed check with a fix, instead of
    # aborting whatever was about to run.
    local mode
    mode="$(_claude_docker_opt network CLAUDE_DOCKER_NETWORK tailscale)"
    case $mode in
        tailscale|default)
            _tc_check_detail="$mode"
            return 0
            ;;
    esac
    _tc_check_detail="unknown network mode '$mode' (expected tailscale or default)"
    _tc_check_fix=("zstyle ':omz:plugins:tupperclaude' network tailscale")
    return 1
    ;;

authkey)
    if [[ -n ${TS_AUTHKEY:-} ]]; then
        _tc_check_detail='from $TS_AUTHKEY'
        return 0
    fi
    # The key is consumed ONLY when a sidecar is first created (see
    # claude-ts-ensure); an existing one reconnects from its state volume
    # without it. So find out whether this directory already has one before
    # calling a missing key a failure — otherwise every established session
    # reports a problem it does not have.
    #
    # WHICH sidecar depends on who is asking, and getting that wrong is a false
    # pass rather than a false alarm:
    #
    #   <arg> given  — the caller is about to create that one specific node and
    #                  wants to know whether it can. Only that node counts. The
    #                  both-variants scan below would let a working BASE sidecar
    #                  vouch for a PLAYWRIGHT sidecar that cannot be created,
    #                  and the caller would go on to create it with an empty key.
    #   <arg> absent — doctor's question: can this machine bring up a sidecar at
    #                  all? Any existing node answers it.
    #
    # Sidecar names belong to _claude_docker_ctx. Ask it in a subshell so the
    # caller's live _tc_* globals survive, with the network option cleared so a
    # broken `network` setting can't stop this check from answering. The arch is
    # irrelevant to a sidecar name — only the variant picks the prefix.
    local -a nodes
    if [[ -n $arg ]]; then
        nodes=("$arg")
    else
        nodes=(${(f)"$(
            zstyle -d ':omz:plugins:tupperclaude' network
            unset CLAUDE_DOCKER_NETWORK
            local v
            for v in base playwright; do
                _claude_docker_ctx arm64 "$v" >/dev/null 2>&1 && print -r -- "$_tc_ts_node"
            done
        )"})
    fi
    local existing='' node
    for node in "${nodes[@]}"; do
        if command docker inspect "$node" >/dev/null 2>&1; then
            existing=$node
            break
        fi
    done

    local ref
    ref="$(_claude_docker_opt op-ref CLAUDE_DOCKER_OP_TS_REF '')"
    if [[ -z $ref ]]; then
        if [[ -n $existing ]]; then
            _tc_check_detail="no key configured — sidecar '$existing' already exists and still works; a key is needed only to create a new one"
            return 0
        fi
        _tc_check_detail='no auth key configured'
        _tc_check_fix=(
            "export TS_AUTHKEY='tskey-auth-...'"
            "zstyle ':omz:plugins:tupperclaude' op-ref 'op://Private/Tailscale/authkey'"
            'mint a reusable, tagged key: https://login.tailscale.com/admin/settings/keys'
        )
        return 1
    fi
    if [[ -n "$(command op read "$ref" 2>/dev/null)" ]]; then
        _tc_check_detail="from 1Password ($ref)"
        return 0
    fi
    if [[ -n $existing ]]; then
        _tc_check_detail="1Password reference $ref did not resolve — sidecar '$existing' already exists and still works; the key is needed only to create a new one (op read '$ref' shows the error)"
        return 0
    fi
    _tc_check_detail="1Password reference $ref did not resolve"
    _tc_check_fix=("op read '$ref'    # shows the underlying error")
    return 1
    ;;

op-signin)
    if (( ! ${+commands[op]} )); then
        _tc_check_detail='1Password CLI not installed'
        _tc_check_fix=('brew install --cask 1password-cli')
        return 1
    fi
    if command op whoami >/dev/null 2>&1; then
        _tc_check_detail='signed in'
        return 0
    fi
    _tc_check_detail='locked or signed out'
    _tc_check_fix=('op signin')
    return 1
    ;;

ssh-agent)
    # The forwarded agent socket lives at /run/host-services/ssh-auth.sock —
    # a path inside Docker Desktop's Linux VM, NOT on the macOS host. It cannot
    # be stat'ed from here, so testing for it would always fail. What actually
    # determines whether forwarding works is whether the daemon is Docker
    # Desktop, so check that instead.
    local engine
    engine="$(command docker info --format '{{.OperatingSystem}}' 2>/dev/null)"
    if [[ $engine == "Docker Desktop" ]]; then
        _tc_check_detail='Docker Desktop — agent forwarding available'
        return 0
    fi
    _tc_check_detail="engine is '${engine:-unknown}', not Docker Desktop"
    _tc_check_fix=('SSH agent forwarding into the container needs Docker Desktop for Mac.'
                   'Everything else still works; git over SSH inside the sandbox will not.')
    return 1
    ;;

*)
    _claude_docker_err "unknown check '$what'"
    return 1
    ;;
esac
