#!/usr/bin/env zsh
# Run Claude Code in the linux/amd64 base container: native on Intel Macs,
# QEMU-emulated on Apple Silicon. Extra args pass through to claude.
#
# --help is the WRAPPER's: `claude-docker-amd64 -- --help` passes --help to claude.

[[ "${1-}" == (-h|--help) ]] && { _claude_docker_help claude-docker-amd64; return 0 }
[[ "${1-}" == -- ]] && shift
_claude_docker_run amd64 base "$@"
