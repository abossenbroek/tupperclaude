# claude-code-full-playwright — the production Claude image PLUS headless
# Playwright. Built straight on top of `claude-code-full`, so every feature of
# the base image (all toolchains, LSPs, sandbox runtime, baked config, nightly
# upstream updates) is inherited byte-for-byte. We add exactly one thing:
# Chromium + its OS deps + the Playwright MCP, wired to run headless.
#
# Why FROM claude-code-full (Approach A) and not a Playwright base (Approach B):
# the A/B experiment showed the hard part was never Playwright — `playwright
# install --with-deps chromium` is one step and resolves cleanly on Ubuntu 25.10
# — it was reproducing Claude's sandbox base. FROM claude-code-full guarantees
# feature parity and keeps inheriting upstream base maintenance. The losing
# arm of that experiment (Claude reconstructed on the Playwright base) was not
# kept — it is recorded here only so nobody repeats it.
#
# SUPPLY CHAIN — read this before assuming the base image's discipline carries
# over. It does not, and the difference is deliberate. The base Dockerfile pins
# every third-party artifact to an exact version and verifies it against a
# vendor-published sha256. This file cannot do that for the browser, and does
# less than the base everywhere else:
#
#   * `playwright install chromium` downloads a per-arch Chromium build that
#     Playwright resolves itself at run time from a revision embedded in the
#     library. There is no stable, vendor-published checksum for those builds to
#     pin against, and no supported way to hand Playwright a pre-verified binary.
#     The browser is therefore downloaded and executed on TLS trust in
#     playwright.azureedge.net alone. This is the weakest link in the image and
#     the reason this variant is a separate opt-in image rather than the default.
#   * `npx --yes playwright@$PWVER` fetches and executes whatever the npm
#     registry serves for that version. $PWVER is an exact version, so the
#     package is pinned — but no integrity hash of ours is checked, and `--yes`
#     suppresses the prompt that would otherwise surface an unexpected fetch.
#   * $PWVER itself is resolved live (`npm view @playwright/mcp@X dependencies.
#     playwright`) rather than hardcoded. That is a deliberate trade: it keeps the
#     MCP and the library provably in lockstep from one pinned source instead of
#     two ARGs that can drift. The lookup is guarded below so an empty result
#     fails the build instead of installing `playwright@`.
#
# What IS pinned: @playwright/mcp to an exact version (one ARG, referenced three
# times), the resulting playwright library version derived from it, and the base
# image via BASE_IMAGE. npm installs use --ignore-scripts where the package
# permits it.
#
# BASE_IMAGE must be declared before FROM (ARGs used by FROM are resolved in an
# outer scope that only sees pre-FROM ARGs) — the default here is only a
# fallback for a manual build; claude-docker-build-arm-playwright /
# claude-docker-build-amd64-playwright always pass
# --build-arg BASE_IMAGE=claude-code-full-<arch> explicitly.
ARG BASE_IMAGE=claude-code-full-arm64
FROM ${BASE_IMAGE}

# Builds for both linux/arm64 and linux/amd64 — nothing below is arch-specific:
# it is all npm/npx driven, and Playwright's own installers resolve the correct
# arch build for install-deps and the Chromium binary automatically.

# ── Playwright OS dependencies (root/apt) ────────────────────────────────────
# Browsers live in a dedicated path owned by `agent` so the Playwright MCP can
# both read the baked browser and, if its version ever drifts, download a
# matching one at runtime (a read-only browser dir is what broke the MCP in the
# A probe). PWVER is derived from the pinned MCP so install-deps pulls the right
# dependency set. No X11/Xvfb/XDG — these are headless-only deps.
USER root

# Same reason as the base image: without pipefail (and without the explicit
# non-empty guards below) a failed lookup or download yields an empty value that
# the next command happily consumes.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV PLAYWRIGHT_BROWSERS_PATH=/usr/local/ms-playwright

# Playwright validates the host OS against an allowlist before downloading a
# browser, and the base image now tracks Ubuntu 26.04, which is newer than any
# published Playwright's list — `playwright install chromium` aborts with
# "Playwright does not support chromium on ubuntu26.04-arm64" even though the
# download and the browser itself work perfectly on it (verified: Chrome
# Headless Shell 151 installs and runs on ubuntu26.04-arm64).
#
# This is an allowlist gap, not a real incompatibility, so skip the check. Set
# as a persistent ENV rather than per-RUN because the Playwright MCP re-runs the
# same validation when it launches the browser at run time.
#
# Revisit when Playwright adds Ubuntu 26.04: drop this and the build should work
# unchanged.
ENV PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS=1

# The MCP version is pinned in exactly one place and referenced everywhere below
# (OS deps, the npm install, and the mcpServers registration), so the three can
# never drift out of step.
#
# 0.0.79 is the floor, not an arbitrary bump: it resolves to playwright
# 1.63.0-alpha, and versions before ~1.62 IGNORE
# PLAYWRIGHT_SKIP_VALIDATE_HOST_REQUIREMENTS entirely — the previously pinned
# 0.0.75 (playwright 1.61.0-alpha) fails on Ubuntu 26.04 no matter what that
# variable is set to. Verified by installing chromium with each in turn.
ARG PLAYWRIGHT_MCP_VERSION=0.0.79

# `npm view` prints nothing and exits 0 when the field is absent, and a command
# substitution's failure does not abort the RUN — so the result is checked
# explicitly. Unguarded, a bad lookup would run `npx --yes playwright@`, which
# resolves to the registry's newest release: an unpinned install, silently.
RUN mkdir -p /usr/local/ms-playwright && chown agent:agent /usr/local/ms-playwright && \
    PWVER="$(npm view "@playwright/mcp@$PLAYWRIGHT_MCP_VERSION" dependencies.playwright)" && \
    if [ -z "$PWVER" ]; then echo "could not resolve playwright version for @playwright/mcp@$PLAYWRIGHT_MCP_VERSION" >&2; exit 1; fi && \
    npx --yes "playwright@$PWVER" install-deps chromium

# ── Playwright library + MCP + matching browser (as agent, like the base's
#    other npm globals) ────────────────────────────────────────────────────────
USER agent
# MCP pinned exact; the matching Playwright lib version is derived from the
# pinned MCP (npm view dependencies.playwright) rather than pinned separately —
# this keeps both exactly in lockstep, and both are still pinned as a result,
# just via one source of truth instead of two ARGs that could drift apart.
# --ignore-scripts blocks npm lifecycle scripts on install; the browser itself
# cannot use --ignore-scripts because `playwright install chromium` has to
# download a browser binary, not run an npm postinstall — it's fetched
# explicitly afterward instead.
#
# (No `ARG PLAYWRIGHT_MCP_VERSION` redeclare here: ARG scope is per-stage, there
# is only one stage after FROM, so the value declared above is still live.)
RUN PWVER="$(npm view "@playwright/mcp@$PLAYWRIGHT_MCP_VERSION" dependencies.playwright)" && \
    if [ -z "$PWVER" ]; then echo "could not resolve playwright version for @playwright/mcp@$PLAYWRIGHT_MCP_VERSION" >&2; exit 1; fi && \
    npm install -g --ignore-scripts "@playwright/mcp@$PLAYWRIGHT_MCP_VERSION" "playwright@$PWVER" && \
    playwright install chromium

# ── Register the Playwright MCP so it is PRESENT in every normal session ──────
# The base bakes the playwright plugin's marketplace metadata but not its runtime
# cache, so the plugin route surfaces zero tools. A self-contained mcpServers
# entry (pinned to the same MCP, using the baked browser) fixes that.
RUN jq '.mcpServers.playwright = {"command":"npx","args":["-y","@playwright/mcp@'"$PLAYWRIGHT_MCP_VERSION"'","--headless","--browser","chromium","--no-sandbox"]}' \
      /home/agent/.claude.json > /tmp/cj.json && \
    mv /tmp/cj.json /home/agent/.claude.json
